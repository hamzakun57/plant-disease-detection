# ============================================
# Variables d'environnement du frontend
# ============================================
# Copiez ce fichier vers "frontend/.env" puis remplissez vos propres valeurs.
# Le fichier ".env" est ignoré par Git : ne le committez JAMAIS.
#
# Commande rapide (Windows PowerShell) :
#   copy .env.example .env
#
# ⚠️ Tout ce qui est préfixé par VITE_ est exposé dans le bundle JavaScript
#    envoyé au navigateur. N'y placez JAMAIS de secret.

# URL de base de l'API backend (FastAPI).
# Développement local :
VITE_API_URL=http://localhost:8000/api
#
# Production — remplacez par VOTRE_DOMAINE, par exemple :
# VITE_API_URL=https://api.VOTRE_DOMAINE/api