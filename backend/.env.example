# ============================================
# Variables d'environnement du backend
# ============================================
# Copiez ce fichier vers "backend/.env" puis remplissez vos propres valeurs.
# Le fichier ".env" est ignoré par Git : ne le committez JAMAIS.
# (la ligne "!.env.example" dans .gitignore autorise ce fichier à être suivi)
#
# Commande rapide (Windows PowerShell) :
#   copy .env.example .env

# --- Service externe : NVIDIA NIM (chatbot IA) -----------------------------
# OBLIGATOIRE pour l'endpoint POST /api/chat/expert.
# Obtenez votre propre clé sur : https://build.nvidia.com
# AUCUNE clé n'est fournie ici. Ne committez pas la vôtre.
NVIDIA_NIM_API_KEY=

# URL du endpoint de chat NVIDIA NIM (valeur publique, généralement inchangée)
NIM_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Modèle Llama utilisé par le chatbot
NIM_MODEL=meta/llama-3.2-3b-instruct

# --- Service externe : Hugging Face Hub (chargement du modèle ML) -----------
# Nécessaire uniquement si vous publiez le modèle sur un dépôt HF privé.
# Laissez vide pour un dépôt public.
HF_TOKEN=